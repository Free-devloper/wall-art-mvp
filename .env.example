# ==============================================================================
# Wall Art — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==============================================================================

# --- Application ---
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# --- Database (PostgreSQL) ---
# Use "postgres" as host when running via docker-compose.
# Use "localhost" when running the backend directly on host.
DATABASE_URL=postgresql+asyncpg://wallart:wallart_dev_password@postgres:5432/wallart
POSTGRES_USER=wallart
POSTGRES_PASSWORD=wallart_dev_password
POSTGRES_DB=wallart

# --- Redis ---
# Use "redis" as host when running via docker-compose.
# Use "localhost" when running Redis directly on host.
REDIS_URL=redis://redis:6379/0

# --- Storage ---
# "local" = on-server filesystem (dev, no AWS needed)
# "s3"    = AWS S3 buckets (staging/production)
STORAGE_MODE=local
LOCAL_STORAGE_DIR=/app/local_storage

# --- AWS S3 (only needed when STORAGE_MODE=s3) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2
S3_BUCKET_UPLOADS=wallart-uploads-dev
S3_BUCKET_GENERATIONS=wallart-generations-dev
S3_PRESIGNED_URL_EXPIRY_SECONDS=900

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_your_test_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# --- AI Provider (Replicate) ---
# Leave as placeholder for dev — pipeline generates placeholder images.
REPLICATE_API_TOKEN=r8_your_replicate_token
AI_PROVIDER=replicate

# --- Email (Resend) ---
# Leave blank for dev — emails are logged to console only.
RESEND_API_KEY=
EMAIL_FROM=orders@wallart.co.uk

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# --- AI Spend Circuit Breaker ---
DAILY_AI_SPEND_CAP_USD=50.00
MONTHLY_AI_SPEND_CAP_USD=1000.00

# --- Data Retention ---
RETENTION_DAYS=90

# --- Admin ---
ADMIN_DEFAULT_EMAIL=admin@wallart.co.uk
ADMIN_DEFAULT_PASSWORD=change-me-on-first-login

# --- Sentry (optional) ---
SENTRY_DSN=
